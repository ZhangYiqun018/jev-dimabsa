+def view_priors(extractions, text):
+    """Span scores from the per-token probabilities averaged over BIO label views, and the
+    minimum of each view's own span score."""
+    views = [marginals(x, text) for x in extractions]
+    tokens = views[0][0]
+    text_l = text.lower()
+    out = {}
+    for role in ('aspect', 'opinion'):
+        mean = [{k: sum(v[1][role][i].get(k, 0) for v in views) / len(views) for k in 'BIO'}
+                for i in range(len(tokens))]
+        own = [lattice_spans(tokens, v[1][role], 1e-6) for v in views]
+        scores = {}
+        for (s, e), value in lattice_spans(tokens, mean, 1e-6).items():
+            scores[text_l[s:e]] = max(scores.get(text_l[s:e], 0), value)
+        lowest = {}
+        for s, e in {k for spans in own for k in spans}:
+            value = min(spans.get((s, e), 0) for spans in own)
+            lowest[text_l[s:e]] = max(lowest.get(text_l[s:e], 0), value)
+        out[role] = (scores, lowest)
+    return out
+
