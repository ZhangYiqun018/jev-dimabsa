# The DimABSA dataset terms forbid redistribution:
#   "Datasets must not be redistributed or shared with third parties."
# So neither the data nor anything embedding its text is committed.
vendor/
reports/**/*.jsonl
reports/**/*.jsonl.meta.json
reports/_gold_*
reports/social/

.venv/
__pycache__/
*.pyc
.DS_Store

# local session config
.claude/
AGENTS.md

# Calibration experiment inputs and raw responses contain dataset text.
reports/**/cache/
reports/**/calls/
# Scorer console output; the metrics are kept in each summary.json.
reports/**/*_scorer.txt

# Console output from the local calibration runs.
reports/calibration_*execution.log
reports/calibration_*/run.log
